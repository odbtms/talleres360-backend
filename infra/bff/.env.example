# Copiar como infra/bff/.env (ignorado por git) y completar.

# Entra ID: registro de la API (api-cloud)
ENTRA_TENANT_ID=
API_CLIENT_ID=

# IP privada de la VM ec2-apps (no cambia al detener/encender la instancia)
ORDERS_URL=http://<IP-privada-ec2-apps>:8081

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Subir a DEBUG para diagnosticar 401/403 en el BFF
SECURITY_LOG_LEVEL=INFO
